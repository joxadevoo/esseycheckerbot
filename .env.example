# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# AI Provider: 'openai' or 'groq'
AI_PROVIDER=openai

# OpenAI API Key (obtain from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Groq API Key (optional fallback, from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database URL
# For local development: sqlite+aiosqlite:///bot.db
# For production PostgreSQL (Supabase/Neon/Self-hosted): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Redis URL (Queue & Cache)
# For local Redis: redis://localhost:6379/0
# For Upstash Redis: rediss://default:password@endpoint.upstash.io:6379
# If empty or unavailable, bot will automatically fallback to in-memory async queue for local testing
REDIS_URL=

# Limits & Throttling
DAILY_USER_LIMIT=5
DAILY_GROUP_LIMIT=50
CACHE_TTL_SECONDS=86400

# Whitelisted Admins (Unlimited Tests)
ADMIN_IDS=7326292681

# Webhook Configuration (optional, if empty bot runs in long-polling mode)
WEBHOOK_URL=
WEBHOOK_PORT=8000
