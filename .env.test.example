# ==========================================
# TEST / STAGING ENVIRONMENT CONFIGURATION
# ==========================================
# Bu fayldan nusxa olib, '.env.test' nomli fayl yarating!
# Ushbu rejimda ishlash: python main.py --test

# 1. Telegram Test Bot Token (@BotFather dan yangi test bot ochib oling)
BOT_TOKEN=your_test_bot_token_here

# 2. AI Sozlamalari (OpenAI yoki Groq)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Test Ma'lumotlar Bazasi (Production bot.db ga aralashmaydi!)
DATABASE_URL=sqlite+aiosqlite:///test_bot.db

# 4. Redis (bo'sh qoldirsangiz, ichki xotirada ishlayveradi)
REDIS_URL=

# 5. Limitlar (Test rejimida erkinroq test qilish uchun)
DAILY_USER_LIMIT=100
DAILY_GROUP_LIMIT=200
CACHE_TTL_SECONDS=60

# 6. Admin ID
ADMIN_IDS=7326292681

# 7. Test porti (Production bilan to'qnashmasligi uchun 8081)
PORT=8081
